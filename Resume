        "from fpdf import FPDF\n",
        "\n",
        "class ResumePDF(FPDF):\n",
        "    def header(self):\n",
        "        self.set_font(\"Times\", \"B\", 13)\n",
        "        self.cell(0, 8, self.name, ln=True, align=\"C\")\n",
        "        self.set_font(\"Times\", \"\", 10)\n",
        "        self.cell(0, 6, f\"{self.email} | {self.phone}\", ln=True, align=\"C\")\n",
        "        self.cell(0, 6, f\"{self.linkedin} | {self.github}\", ln=True, align=\"C\")\n",
        "        self.ln(6)\n",
        "\n",
        "    def section_title(self, title):\n",
        "        self.set_font(\"Times\", \"B\", 11)\n",
        "        self.cell(0, 5, title, ln=True)\n",
        "        self.ln(1)\n",
        "        self.set_draw_color(0, 0, 0)\n",
        "        self.line(10, self.get_y(), 200, self.get_y())\n",
        "        self.ln(3)\n",
        "\n",
        "    def section_body(self, text):\n",
        "        self.set_font(\"Times\", \"\", 10)\n",
        "        self.multi_cell(0, 5, text)\n",
        "        self.ln(2)\n",
        "\n",
        "    def bullet_list(self, items):\n",
        "        self.set_font(\"Times\", \"\", 10)\n",
        "        for item in items:\n",
        "            self.cell(5)  # indentation\n",
        "            self.cell(0, 5, f\"- {item}\", ln=True)\n",
        "        self.ln(2)\n",
        "\n",
        "    def education_section(self, education_list):\n",
        "        self.set_font(\"Times\", \"\", 10)\n",
        "        for entry in education_list:\n",
        "            self.set_x(10)\n",
        "            self.cell(5, 5, \"-\")\n",
        "            self.cell(0, 5, entry['degree'], ln=1)\n",
        "\n",
        "            self.set_x(15)\n",
        "            self.cell(120, 5, entry['institution'], ln=0)\n",
        "            self.cell(0, 5, entry['year'], ln=1, align=\"R\")\n",
        "            self.ln(1)\n",
        "        self.ln(2)\n",
        "\n",
        "    def certifications_section(self, certificates):\n",
        "        self.set_font(\"Times\", \"\", 10)\n",
        "        for cert in certificates:\n",
        "            name = cert['name']\n",
        "            year = cert['year']\n",
        "            self.set_x(10)\n",
        "            self.cell(130, 5, f\"- {name}\", ln=0)\n",
        "            self.cell(0, 5, year, ln=1, align='R')\n",
        "        self.ln(2)\n",
        "\n",
        "def generate_resume(name, email, phone, linkedin, github, summary, education, experience, projects, skills, certificates):\n",
        "    pdf = ResumePDF()\n",
        "    pdf.name = name\n",
        "    pdf.email = email\n",
        "    pdf.phone = phone\n",
        "    pdf.linkedin = linkedin\n",
        "    pdf.github = github\n",
        "\n",
        "    pdf.add_page()\n",
        "    pdf.set_auto_page_break(auto=True, margin=10)\n",
        "\n",
        "    # EXECUTIVE SUMMARY\n",
        "    pdf.section_title(\"EXECUTIVE SUMMARY\")\n",
        "    pdf.section_body(summary)\n",
        "\n",
        "    # EDUCATION\n",
        "    pdf.section_title(\"EDUCATION\")\n",
        "    pdf.education_section(education)\n",
        "\n",
        "    # EXPERIENCE\n",
        "    pdf.section_title(\"EXPERIENCE\")\n",
        "    for exp in experience:\n",
        "        pdf.set_font(\"Times\", \"B\", 11)\n",
        "        pdf.cell(5)\n",
        "        pdf.cell(0, 5, exp['title'], ln=True)\n",
        "        pdf.set_font(\"Times\", \"\", 10)\n",
        "        pdf.bullet_list(exp['description'])\n",
        "\n",
        "    # PROJECTS\n",
        "    pdf.section_title(\"PROJECTS\")\n",
        "    for project in projects:\n",
        "        pdf.set_font(\"Times\", \"B\", 10)\n",
        "        pdf.cell(5)\n",
        "        pdf.cell(0, 5, project['title'], ln=True)\n",
        "        pdf.set_font(\"Times\", \"\", 10)\n",
        "        pdf.bullet_list(project['description'])\n",
        "\n",
        "    # SKILLS\n",
        "    pdf.section_title(\"SKILLS\")\n",
        "    pdf.set_font(\"Times\", \"\", 10)\n",
        "    for skill in skills:\n",
        "        pdf.cell(0, 5, skill, ln=True)\n",
        "    pdf.ln(2)\n",
        "\n",
        "    # CERTIFICATIONS\n",
        "    pdf.section_title(\"CERTIFICATIONS\")\n",
        "    pdf.certifications_section(certificates)\n",
        "\n",
        "    # Save PDF\n",
        "    pdf.output(\"Resume.pdf\", \"F\")\n",
        "    print(\"✅ Resume generated successfully as 'Resume.pdf'\")\n",
